name: Hourly Downloader Bot

on:
  schedule:
    # هەموو ٢٣ کاژمێر جارێک جێبەجێ دەبێت
    - cron: '0 */23 * * *'
  workflow_dispatch: # ڕێگەت پێدەدات بەدەستی خۆت لە هەر کاتێک بێت تاقیی بکەیتەوە

jobs:
  run-downloader:
    runs-on: ubuntu-latest

    steps:
    - name: Check out repository
      uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install requests

    - name: Run script
      run: python bot.py

    - name: Save downloaded file
      uses: actions/upload-artifact@v3
      with:
        name: downloaded-data
        path: downloaded_file.zip
